<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_turntable_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp">

    <!-- Turntable Vinyl Outer Disc Base -->
    <ImageView
        android:id="@+id/widget_turntable_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:contentDescription="Turntable Vinyl Album Art" />

    <!-- Top Right Nav Container: Previous & Next -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/widget_turntable_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:src="@drawable/audio_service_skip_previous"
            android:contentDescription="Previous Track" />

        <ImageButton
            android:id="@+id/widget_turntable_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:src="@drawable/audio_service_skip_next"
            android:contentDescription="Next Track" />
    </LinearLayout>

    <!-- Bottom Left Play/Pause Container -->
    <FrameLayout
        android:id="@+id/widget_turntable_play_container"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp">

        <ImageView
            android:id="@+id/widget_turntable_play_pause"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/audio_service_play_arrow"
            android:contentDescription="Play Pause" />
    </FrameLayout>

</FrameLayout>
