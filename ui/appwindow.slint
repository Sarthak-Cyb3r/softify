import { Button, LineEdit, Slider, ScrollView } from "std-widgets.slint";

export struct TrackItem {
    id: string,
    title: string,
    artist: string,
    album: string,
    duration_str: string,
    is_liked: bool,
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 42px;
    background: active ? #282828 : touch.has-hover ? #1f1f1f : transparent;
    border-radius: 6px;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: start;
        Text {
            text: root.label;
            color: root.active ? #1DB954 : (touch.has-hover ? #FFFFFF : #B3B3B3);
            font-size: 14px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
        }
    }
}

component TrackRow inherits Rectangle {
    in property <int> index: 0;
    in property <TrackItem> track;
    in property <bool> is_current: false;
    callback row_clicked();

    height: 52px;
    background: root.is_current ? #2a2a2a : touch.has-hover ? #1a1a1a : transparent;
    border-radius: 6px;

    touch := TouchArea {
        clicked => { root.row_clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        spacing: 12px;

        // Track number / indicator
        Text {
            width: 32px;
            text: root.is_current ? "▶" : (root.index + 1);
            color: root.is_current ? #1DB954 : #727272;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        // Title and Artist
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 3;
            spacing: 2px;
            Text {
                text: root.track.title;
                color: root.is_current ? #1DB954 : #FFFFFF;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.track.artist;
                color: #A7A7A7;
                font-size: 12px;
                overflow: elide;
            }
        }

        // Album
        Text {
            horizontal-stretch: 2;
            text: root.track.album;
            color: #A7A7A7;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }

        // Duration
        Text {
            width: 60px;
            text: root.track.duration_str;
            color: #A7A7A7;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

export component AppWindow inherits Window {
    title: "Softify - Pure Native Audio";
    preferred-width: 1100px;
    preferred-height: 740px;
    min-width: 800px;
    min-height: 500px;
    background: #121212;

    in-out property <[TrackItem]> tracks: [];
    in-out property <string> current_title: "Softify Native Audio";
    in-out property <string> current_artist: "Select or search a track to begin playback";
    in-out property <string> current_status: "Ready";
    in-out property <bool> is_playing: false;
    in-out property <float> progress: 0.0;
    in-out property <string> time_display: "00:00 / 00:00";
    in-out property <float> volume: 0.8;
    in-out property <string> active_tab: "library";
    in-out property <int> current_track_index: -1;

    callback search_submitted(string);
    callback play_track_index(int);
    callback toggle_play_pause();
    callback next_track();
    callback previous_track();
    callback seek_position(float);
    callback volume_changed(float);
    callback load_library();
    callback load_liked_songs();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Top Main Area (Sidebar + Content)
        HorizontalLayout {
            vertical-stretch: 1;

            // Left Navigation Sidebar
            Rectangle {
                width: 240px;
                background: #000000;

                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    // Logo
                    HorizontalLayout {
                        padding-bottom: 12px;
                        spacing: 8px;
                        Text {
                            text: "♫ Softify";
                            color: #1DB954;
                            font-size: 20px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }

                    NavButton {
                        label: "Library Tracks";
                        active: root.active_tab == "library";
                        clicked => {
                            root.active_tab = "library";
                            root.load_library();
                        }
                    }

                    NavButton {
                        label: "Liked Songs";
                        active: root.active_tab == "liked";
                        clicked => {
                            root.active_tab = "liked";
                            root.load_liked_songs();
                        }
                    }

                    NavButton {
                        label: "Search & Stream";
                        active: root.active_tab == "search";
                        clicked => {
                            root.active_tab = "search";
                        }
                    }

                    // Spacer
                    Rectangle {
                        vertical-stretch: 1;
                    }

                    // Technical specs footnote
                    Text {
                        text: "Engine: 100% Pure Rust\nGUI: Slint Native GPU\nAudio: Rodio + Symphonia";
                        color: #555555;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
            }

            // Central Content Area
            Rectangle {
                background: #121212;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    // Search and Header Bar
                    HorizontalLayout {
                        height: 42px;
                        spacing: 12px;

                        search_input := LineEdit {
                            placeholder-text: "Search songs, artists, Coke Studio, JioSaavn, YouTube...";
                            font-size: 14px;
                            accepted => {
                                root.active_tab = "search";
                                root.search_submitted(self.text);
                            }
                        }

                        Button {
                            text: "Search";
                            width: 100px;
                            clicked => {
                                root.active_tab = "search";
                                root.search_submitted(search_input.text);
                            }
                        }
                    }

                    // Header row
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 16px;
                        spacing: 12px;
                        height: 24px;

                        Text { width: 32px; text: "#"; color: #727272; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
                        Text { horizontal-stretch: 3; text: "TITLE"; color: #727272; font-size: 12px; font-weight: 700; }
                        Text { horizontal-stretch: 2; text: "ALBUM"; color: #727272; font-size: 12px; font-weight: 700; }
                        Text { width: 60px; text: "TIME"; color: #727272; font-size: 12px; font-weight: 700; horizontal-alignment: right; }
                    }

                    // Track List Scroll View
                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 2px;
                            alignment: start;

                            for track[idx] in root.tracks: TrackRow {
                                index: idx;
                                track: track;
                                is_current: root.current_track_index == idx;
                                row_clicked => {
                                    root.current_track_index = idx;
                                    root.play_track_index(idx);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Bottom Persistent Player Bar
        Rectangle {
            height: 90px;
            background: #181818;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 16px;
                alignment: space-between;

                // Left: Current Track Info
                HorizontalLayout {
                    width: 260px;
                    alignment: start;
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: root.current_title;
                            color: #FFFFFF;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: root.current_artist;
                            color: #B3B3B3;
                            font-size: 12px;
                            overflow: elide;
                        }
                        Text {
                            text: root.current_status;
                            color: #1DB954;
                            font-size: 11px;
                        }
                    }
                }

                // Center: Transport Controls and Progress Slider
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 6px;

                    // Buttons
                    HorizontalLayout {
                        alignment: center;
                        spacing: 20px;

                        Button {
                            text: "⏮";
                            width: 44px;
                            clicked => { root.previous_track(); }
                        }

                        Button {
                            text: root.is_playing ? "⏸" : "▶";
                            width: 50px;
                            primary: true;
                            clicked => { root.toggle_play_pause(); }
                        }

                        Button {
                            text: "⏭";
                            width: 44px;
                            clicked => { root.next_track(); }
                        }
                    }

                    // Progress Slider & Timers
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        Slider {
                            horizontal-stretch: 1;
                            minimum: 0.0;
                            maximum: 1.0;
                            value: root.progress;
                            changed(val) => { root.seek_position(val); }
                        }

                        Text {
                            width: 90px;
                            text: root.time_display;
                            color: #B3B3B3;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                    }
                }

                // Right: Volume Slider
                HorizontalLayout {
                    width: 200px;
                    alignment: end;
                    spacing: 8px;

                    Text {
                        text: "🔊";
                        vertical-alignment: center;
                        color: #B3B3B3;
                        font-size: 14px;
                    }

                    Slider {
                        width: 120px;
                        minimum: 0.0;
                        maximum: 1.0;
                        value: root.volume;
                        changed(val) => { root.volume_changed(val); }
                    }
                }
            }
        }
    }
}
